<?xml version="1.0" encoding="utf-8"?>
<!--
  vendor/ holds ValveResourceFormat 20.0.6980 with upstream's VCS version 72 parser support
  (cbca49a0b) backported: CS2's shaders moved to VCS 72 and no tagged VRF release reads them yet.
  Only the version range and three enums change, so exports are otherwise identical to 20.0.6980.
  Drop vendor/ and this file once a nuget.org release reads VCS 72.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="vendor" value="vendor" />
  </packageSources>
</configuration>
