<?xml version="1.0" encoding="utf-8"?>
<!--
  vendor/ holds ValveResourceFormat 20.0.6980 with two additions no tagged VRF release has yet, so
  exports are otherwise identical to 20.0.6980:
  - Upstream's VCS version 72 parser support (cbca49a0b) backported: CS2's shaders moved to VCS 72.
    Only the version range and three enums change.
  - vtex format 33, the engine's R8_UNORM, which upstream does not read either. CS2 v2000922 began
    recompiling its I8 textures to it with the same texel bytes, so it decodes as I8 and those
    textures export the PNG they did before.
  The .patch beside the package is the whole source change. To rebuild, apply it to VRF's 20.0 tag
  exported outside a git repository and run, with the package version bumped:
    GITHUB_RUN_NUMBER=6980 dotnet pack ValveResourceFormat/ValveResourceFormat.csproj -c Release
      -p:PackageVersion=20.0.6980-vcs72-r8
  Drop vendor/ and this file once a nuget.org release reads both.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="vendor" value="vendor" />
  </packageSources>
</configuration>
